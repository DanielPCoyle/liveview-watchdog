# Everything here is OPTIONAL. With no .env at all the app runs fully: a private
# wall backed by localStorage, no analytics, no error reporting. Each block below
# turns on one production path, and each is code-split so an unconfigured build
# never downloads the vendor SDK.
#
#   cp .env.example .env

# ── Shared wall (Firebase Realtime Database) ────────────────────────────────
# With these set, the feed registry is live across every operator connected to
# the same database instead of living in one browser. Without them the wall is
# private and stored locally.
#
# The browser only ever READS a wall it did not create, so these are publishable
# client keys, not secrets — the security boundary is the RTDB rules, not the
# config. Lock /wall down before pointing a real deployment at it.
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ── Error reporting (Sentry) ────────────────────────────────────────────────
# Unset: errors go to the console and the UI still tells the operator when the
# watchdog worker has died. Set: the same errors are also reported.
VITE_SENTRY_DSN=

# ── Analytics (GA4) ─────────────────────────────────────────────────────────
# Domain events only — feeds registered, signal lost/restored, escalations —
# not a click tally. Unset: no analytics script is loaded at all.
VITE_GA_ID=

# ── Test seam ───────────────────────────────────────────────────────────────
# `?mock=1` on the URL replaces the seeded public cameras with a synthetic feed
# generated in the browser, so the end-to-end suite does not depend on a
# third-party CCTV origin being up. Nothing to configure here; documented so the
# seam is discoverable.
